# Sentry source map upload auth token for LOCAL client builds
#
# Copy this file to `.env.sentry-build-plugin` (gitignored) and fill in your
# token. It is read by client/vite.config.ts to upload source maps from a local
# development build (`yarn build-front:dev` with enableSentryInDev set); other
# modes ignore this file, so a local production build never uploads. In CI the
# token comes from the SENTRY_AUTH_TOKEN build secret instead, so this file is
# only for local use.
#
# Create a token at https://konsti.sentry.io/settings/auth-tokens/
# (Release:admin, Organization:Read)
SENTRY_AUTH_TOKEN=
