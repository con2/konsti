{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021", "dom"],
    "jsx": "react-jsx",
    "types": ["mdx", "node"],
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo"
  },
  // Vite applies the path aliases only to files listed here, so MDX imports need the explicit pattern
  "include": ["src/**/*", "src/**/*.mdx", "../shared/**/*", "vitest.config.ts"]
}
