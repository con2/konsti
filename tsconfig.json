{
  "compilerOptions": {
    "module": "preserve",
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    // Scripts run with plain node, which resolves imports of local .ts files
    // only with their explicit extension
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Every project sets its own tsBuildInfoFile: this option is inherited
    // through `extends`, and sharing one path would make the projects
    // overwrite each other's build info on every run
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/root.tsbuildinfo",
    "allowUnreachableCode": false,
    "noErrorTruncation": true,
    "target": "es2025",
    "lib": ["es2025", "dom"],
    "types": ["node"],
    "libReplacement": false,
    "paths": {
      "client/*": ["./client/src/*"],
      "server/*": ["./server/src/*"],
      "shared/*": ["./shared/*"],
      "playwright/*": ["./playwright/*"],
      "scripts/*": ["./scripts/*"]
    }
  },
  "include": [
    "*.ts",
    // Build tooling belongs here rather than in the client project: it runs on
    // Node and imports from scripts/, while the client project is pinned to a
    // browser-era lib to catch unsupported APIs
    "client/vite.config.ts",
    "playwright/**/*.ts",
    "scripts/**/*.ts",
    ".claude/hooks/**/*.ts"
  ]
}
