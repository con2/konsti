{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "description": "Konsti sign-up tool server",
  "author": {
    "name": "Arttu Hanska"
  },
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "eslint": "yarn run -TB eslint --cache --no-warn-ignored .",
    "fixer": "tsx src/features/statistics/dataFixer.ts --",
    "generate-data": "DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.development tsx --import=./src/utils/applyPortOffset.ts -r dotenv/config src/test/test-data-generation/generateTestDataCli.ts",
    "initialize-db": "tsx src/utils/initializeDatabase.ts",
    "generate-serials": "tsx src/utils/generateSerials.ts",
    "remove-invalid-games": "NODE_ENV=development tsx src/test/scripts/removeInvalidProgramItems.ts",
    "start": "tsx --import=./src/utils/instrument.ts src/index.ts",
    "start:ci": "NODE_ENV=development SETTINGS=ci tsx --import=./src/utils/applyPortOffset.ts --import=./src/utils/instrument.ts src/index.ts",
    "start:dev": "NODE_ENV=development SETTINGS=development DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.development tsx watch --clear-screen=false --import=./src/utils/applyPortOffset.ts --import=./src/utils/instrument.ts -r dotenv/config src/index.ts",
    "start:test": "NODE_ENV=development SETTINGS=development DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.test tsx watch --clear-screen=false --import=./src/utils/applyPortOffset.ts --import=./src/utils/instrument.ts -r dotenv/config src/index.ts",
    "start:test:coverage": "NODE_ENV=development SETTINGS=development DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.test tsx --import=./src/utils/applyPortOffset.ts --import=./src/utils/instrument.ts -r dotenv/config src/index.ts",
    "stats": "tsx src/features/statistics/statGenerator.ts --",
    "stats:gen-docs": "tsx src/features/statistics/docGenerator.ts",
    "test": "yarn run -T vitest run",
    "test-assign": "NODE_ENV=development tsx src/test/scripts/testAssignment.ts",
    "simulate-lottery": "NODE_ENV=development tsx src/test/scripts/simulate-lottery/simulateLottery.ts",
    "test:watch": "yarn run -T vitest watch",
    "type-check": "yarn run -T tsc --noEmit",
    "update-popularity": "NODE_ENV=development tsx src/test/scripts/testUpdateProgramItemPopularity.ts",
    "verify-results": "NODE_ENV=development tsx src/test/scripts/testVerifyResults.ts",
    "update-kompassi-data": "NODE_ENV=development DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.development tsx --import=./src/utils/applyPortOffset.ts -r dotenv/config src/test/scripts/loadKompassiDataToDb.ts",
    "load-past-event-data": "NODE_ENV=development DOTENV_CONFIG_QUIET=false DOTENV_CONFIG_PATH=.env.development tsx --import=./src/utils/applyPortOffset.ts -r dotenv/config src/test/scripts/loadPastEventDataToDb.ts",
    "update-kompassi-datadump": "NODE_ENV=development tsx src/test/scripts/updateKompassiDataDump.ts",
    "check-start-times": "NODE_ENV=development tsx src/test/scripts/checkStartTimes.ts",
    "check-missing-konsti-program-type": "NODE_ENV=development tsx src/test/scripts/checkMissingKonstiProgramType.ts",
    "docker:db": "tsx src/test/scripts/dockerDb.ts",
    "find-unused-translation-keys": "tsx src/test/scripts/findUnusedTranslationKeys.ts"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@sentry/node": "11.10.0",
    "bcryptjs": "3.0.3",
    "commander": "15.0.0",
    "croner": "11.0.0",
    "dotenv": "18.0.9",
    "eventassigner-js": "0.1.6",
    "eventassigner-random": "0.3.2",
    "express": "5.3.0",
    "express-static-gzip": "3.0.2",
    "fastest-levenshtein": "1.0.16",
    "fastq": "1.20.3",
    "generate-serial-number": "0.0.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "mongoose-lean-getters": "2.3.1",
    "mongoose-lean-virtuals": "2.1.0",
    "nodemailer": "10.3.1",
    "tsx": "4.23.15",
    "winston": "3.19.0",
    "winston-transport": "4.9.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
