{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/install.ts\"",
            "timeout": 600,
            "statusMessage": "Ensuring dependencies are installed..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"console.log('Reminder: use yarn, not npm.')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prettier.ts\"",
            "timeout": 20,
            "statusMessage": "Running Prettier..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stopChecks.ts\"",
            "timeout": 180,
            "statusMessage": "Type-checking, linting, knip..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/claudeMd.ts\"",
            "timeout": 30,
            "statusMessage": "Checking CLAUDE.md docs..."
          }
        ]
      }
    ]
  }
}
